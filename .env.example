# Private Integration token created INSIDE the sub-account that holds the onboarding pipeline
GHL_TOKEN=pit-xxxxxxxxxxxxxxxxxxxxxxxx
# That sub-account's location id, and the onboarding pipeline id
ONBOARDING_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx
ONBOARDING_PIPELINE_ID=xxxxxxxxxxxxxxxxxxxx
# stepId (same ids as in the widget) -> pipeline stage id
STEP_STAGES={"business-profile":"STAGE_ID_1","import-contacts":"STAGE_ID_2","connect-calendar":"STAGE_ID_3","first-workflow":"STAGE_ID_4"}
# Comma-separated origins allowed to call this API (add your white-label domain too)
ALLOWED_ORIGINS=https://app.gohighlevel.com
# Render Postgres "Internal Database URL". Leave empty to run in-memory (state lost on restart)
DATABASE_URL=
# Any long random string, used for /admin/map
ADMIN_KEY=change-me
