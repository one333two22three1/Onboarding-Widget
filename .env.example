# Private Integration token created INSIDE the sub-account that holds the onboarding pipeline
GHL_TOKEN=pit-****
# That sub-account's location id, and the onboarding pipeline id
ONBOARDING_LOCATION_ID=***************
ONBOARDING_PIPELINE_ID=**************
# stepId (same ids as in the widget) -> pipeline stage id  [must be one line]
STEP_STAGES={"business-profile":"**************","import-contacts":"**************"}
# Comma-separated origins allowed to call this API (add your white-label domain too)
ALLOWED_ORIGINS=https://app.gohighlevel.com
# Render Postgres URL.
# - On Render (deployed): use the "Internal Database URL"  (hostname: dpg-xxx-a)
# - Local development:    use the "External Database URL"  (hostname: dpg-xxx-a.oregon-postgres.render.com)
# Leave empty to run fully in-memory (data lost on restart).
DATABASE_URL=**************
# Any long random string, used for /admin/map
ADMIN_KEY=**************
